{
  "name": "pharaonic/laravel-modulator",
  "description": "Laravel-native modules for Laravel: convention-based discovery, nested submodules, package-provided modules with local overrides, and production-safe autoloading without per-module composer.json files.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "keywords": [
    "laravel",
    "modules",
    "modular",
    "hmvc",
    "submodules",
    "pharaonic"
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/laravel/modulator",
    "issues": "https://github.com/Pharaonic/laravel-modulator/issues",
    "source": "https://github.com/Pharaonic/laravel-modulator"
  },
  "require": {
    "php": ">=8.0 <8.2",
    "laravel/framework": "^8.75"
  },
  "require-dev": {
    "laravel/pint": "^1.5",
    "orchestra/testbench": "^6.25",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6.33"
  },
  "suggest": {
    "filament/filament": "Registers the Filament resources, pages and widgets of modules (module:make:filament-resource).",
    "livewire/livewire": "Registers the Livewire components of modules (module:make:livewire)."
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Laravel\\Modulator\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Laravel\\Modulator\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Laravel\\Modulator\\ModulatorServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false,
        "ignore": {
          "laravel/framework": "No fixed release within Laravel 8; the application chooses the framework release.",
          "league/flysystem": "No fixed release within Laravel 8; the application chooses the framework release."
        }
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
